# Database configuration (Neon Postgres in production, local Postgres or SQLite in dev/tests)
DATABASE_URL=postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST.neon.tech/baton_db?sslmode=require

# Application Secrets (Must be at least 32 characters, cannot start with CHANGE_ME)
JWT_SECRET=CHANGE_ME_MIN_32_CHAR_SECRET_KEY_FOR_JWT
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHAR_REFRESH_TOKEN_KEY
CSRF_SECRET=CHANGE_ME_MIN_32_CHAR_CSRF_SIGNING_KEY

# Redis Store for Distributed Rate Limiting (leave blank for local in-memory fallback)
REDIS_URL=redis://CHANGE_ME_HOST:6379/0

# Environment
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Server-side API Keys (Never expose to client / NEXT_PUBLIC_*)
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY
GITHUB_WEBHOOK_SECRET=CHANGE_ME_MIN_32_CHAR_GITHUB_WEBHOOK_SECRET
GITHUB_PAT=CHANGE_ME_GITHUB_PERSONAL_ACCESS_TOKEN

# Security & Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# Frontend environment variables (Next.js)
# NEXT_PUBLIC_API_URL=http://localhost:8000
