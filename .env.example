# Database configuration (Neon Postgres in production, local Postgres or SQLite in dev/tests)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.neon.tech/baton_db?sslmode=require

# Application Secrets (Must be at least 32 characters)
JWT_SECRET=super_secret_jwt_random_signing_key_at_least_32_bytes_long!
JWT_REFRESH_SECRET=super_secret_refresh_signing_key_at_least_32_bytes_long!
CSRF_SECRET=super_secret_csrf_token_signing_key_at_least_32_bytes_long!

# Environment
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Server-side API Keys (Never expose to client / NEXT_PUBLIC_*)
GEMINI_API_KEY=AIzaSyFakeKeyForGeminiApiExtractionPlaceholder001
GITHUB_WEBHOOK_SECRET=fake_github_webhook_hmac_secret_key_value_min_32_chars!
GITHUB_PAT=ghp_fakeGitHubPersonalAccessTokenForFetcher

# Security & Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# Frontend environment variables (Next.js)
# NEXT_PUBLIC_API_URL=http://localhost:8000

